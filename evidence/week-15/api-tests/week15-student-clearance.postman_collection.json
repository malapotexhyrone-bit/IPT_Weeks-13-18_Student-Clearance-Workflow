    {
      "name": "02 Initiation, retrieval, and duplicate protection",
      "item": [
        {
          "name": "Initiate clearance — normal path",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clearances",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"term_code\": \"{{termCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('idempotencyKey', `week15-${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Clearance is created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.environment.set('clearanceId', body.data.id);",
                  "for (const task of body.data.office_tasks) pm.environment.set(`${task.office.code.toLowerCase()}TaskId`, task.id);",
                  "pm.test('First request is not a replay', () => pm.expect(body.meta.replayed).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay identical idempotency key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clearances",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"term_code\": \"{{termCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Replay returns the existing result', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Replay is identified', () => pm.expect(body.meta.replayed).to.eql(true));",
                  "pm.test('Clearance identity is stable', () => pm.expect(String(body.data.id)).to.eql(String(pm.environment.get('clearanceId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Conflicting duplicate request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "week15-conflicting-key"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clearances",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"term_code\": \"{{termCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Changed duplicate is rejected', () => pm.response.to.have.status(409));",
                  "pm.test('Conflict is explicit', () => pm.expect(pm.response.json().error.code).to.eql('CLEARANCE_ALREADY_EXISTS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read current student clearance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/clearances/current",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current clearance is returned', () => pm.response.to.have.status(200));",
                  "pm.test('Student sees only the current workflow', () => pm.expect(pm.response.json().data.id).to.eql(Number(pm.environment.get('clearanceId'))));"
                ]
              }
            }
          ]
        }
      ]
    },
