    {
      "name": "04 Deficiency, peer-student denial, recovery, and completion",
      "item": [
        {
          "name": "Too-short deficiency description",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{registrarToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/office-tasks/{{registrarTaskId}}/deficiencies",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"bad\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
