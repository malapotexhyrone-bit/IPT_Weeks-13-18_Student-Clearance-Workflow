{
  "info": {
    "name": "PFEBSIT 002 Week 15 — Student Clearance Workflow",
    "description": "Repeatable Project 8 API collection for normal, invalid, boundary, unauthenticated, forbidden, not-found, duplicate, and role/office ownership behavior.\n\nRun only with the controlled fictional database and a local secret environment prepared from WEEK15-API-TEST-GUIDE.md.\n\nTimeout, unavailable-dependency, bounded retry, recovered transient failure, and permanent human-action routing are executed by the Laravel automation and secure-exchange suites because the public API intentionally exposes no failure-injection backdoor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Correlation header is present', () => pm.expect(pm.response.headers.get('X-Correlation-ID')).to.match(/^[0-9A-HJKMNP-TV-Z]{26}$/));",
          "pm.test('JSON responses disable MIME sniffing', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));",
          "pm.test('API responses deny framing', () => pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY'));",
          "pm.test('API responses use no-referrer', () => pm.expect(pm.response.headers.get('Referrer-Policy')).to.eql('no-referrer'));",
          "pm.test('API responses are not stored', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "termCode",
      "value": "2026-2027-1"
    }
  ],
